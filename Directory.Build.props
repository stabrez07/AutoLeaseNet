<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591;NETSDK1206</WarningsNotAsErrors>
    <!--
      NU1902/NU1903: transitive Grpc.Net.Client vulnerability via OpenTelemetry.Exporter.OpenTelemetryProtocol; no exporter version bumps the transitive yet. Re-enable when fixed upstream.
      CA1716: AutoLeaseNet.Domain.Shared is a deliberate DDD building-block namespace; not consumed cross-language.
    -->
    <NoWarn>$(NoWarn);CS1591;NU1902;NU1903;CA1716;IDE0011</NoWarn>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NeutralLanguage>en</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Label="Assembly metadata">
    <Company>AutoLeaseNet</Company>
    <Product>AutoLeaseNet</Product>
    <Copyright>Copyright (c) AutoLeaseNet. All rights reserved.</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Test projects:
       - CA1707: snake_case test method names (BDD-style) are the project convention.
       - CA1859: test helpers intentionally return port interfaces so the test exercises the
         abstraction surface; perf concern doesn't apply in tests.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <NoWarn>$(NoWarn);CA1707;CA1859</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Source Link &amp; deterministic build">
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

</Project>
