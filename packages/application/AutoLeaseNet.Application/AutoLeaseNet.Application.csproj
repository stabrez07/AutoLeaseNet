<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoLeaseNet.Application</RootNamespace>
    <AssemblyName>AutoLeaseNet.Application</AssemblyName>
    <Description>Application layer — use cases (MediatR handlers), sagas, event handlers. Depends only on Domain + Application.Ports.</Description>
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1869</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoLeaseNet.Domain\AutoLeaseNet.Domain.csproj" />
    <ProjectReference Include="..\AutoLeaseNet.Application.Ports\AutoLeaseNet.Application.Ports.csproj" />
    <!--
      Pattern B sub-client reference is intentional per Spec 04 §3.2: the application
      layer talks to ITajeerContractClient directly. If KSA-leasing ever needs to swap
      vendors, introduce a higher-level port (e.g. ILeaseRegistryClient) at that point.
    -->
    <ProjectReference Include="..\..\adapters\AutoLeaseNet.Adapters.Tajeer\AutoLeaseNet.Adapters.Tajeer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
