# =============================================================================
# AutoLeaseNet — Local development environment template
# Copy this to .env.local at the REPO ROOT and adjust values.
# .env.local is gitignored — never commit real secrets.
# =============================================================================

# ---- Docker Compose (compose/docker-compose.yml reads these) ----
SQL_SA_PASSWORD=LocalDev_P@ssw0rd_2026

# ---- BFF connection strings (ASP.NET Core uses __ as section separator) ----
ConnectionStrings__Superplexity="Server=localhost,1433;Database=AutoLeaseNet;User Id=sa;Password=LocalDev_P@ssw0rd_2026;TrustServerCertificate=true;Encrypt=false"
ConnectionStrings__Redis="localhost:6379"

# ---- Tajeer (staging) ----
# Generate Authorization via Tajeer portal: https://tajeerstg.logisti.sa → Users → API Registration
Tajeer__BaseUrl="https://tajeer-stg.api.elm.sa"
Tajeer__IssuanceUrlBase="https://tajeerstg.logisti.sa"
Tajeer__AppId=""
Tajeer__AppKey=""
Tajeer__Authorization=""
Tajeer__WebhookSharedSecret="local-dev-webhook-secret"
Tajeer__IsSandbox=true

# ---- ZATCA (Fatoorah sandbox) ----
Zatca__BaseUrl="https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal"
Zatca__Environment="Sandbox"
Zatca__SandboxCsid=""

# ---- SMS provider (default InMemory locally; switch to Unifonic by setting Sms__Provider) ----
Sms__Provider="InMemory"
# Sms__Unifonic__BaseUrl="https://api.unifonic.com"
# Sms__Unifonic__AppSid=""
# Sms__Unifonic__SenderId="AUTOLEASE"

# ---- Email (default to MailHog SMTP locally) ----
Email__Provider="Smtp"
Email__Smtp__Host="localhost"
Email__Smtp__Port="1025"
Email__Smtp__From="noreply@autoleasenet.local"

# ---- Storage (default Azurite locally) ----
Storage__Provider="AzureBlob"
Storage__AzureBlob__ConnectionString="UseDevelopmentStorage=true"

# ---- Cache ----
Cache__Provider="Redis"

# ---- Identity (Entra) ----
Entra__TenantId=""
Entra__ClientId=""
Entra__ExternalId__TenantId=""
Entra__ExternalId__ClientId=""

# ---- Local dev tenancy override (skips Entra during dev) ----
LocalDev__DefaultTenantId="00000000-0000-0000-0000-000000000001"
LocalDev__BypassAuth=true

# ---- Application Insights (optional for local) ----
ApplicationInsights__ConnectionString=""
